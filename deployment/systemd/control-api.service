[Unit]
Description=Control V2 private application API
After=network.target postgresql.service control-auth-bridge.service
Wants=control-auth-bridge.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=control_api
Group=control_api
WorkingDirectory=/srv/control/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/control/staff-auth.env
ExecStart=/srv/control/current/.venv/bin/python -m uvicorn services.api.app:app --host 127.0.0.1 --port 8100 --workers 2 --no-server-header --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
